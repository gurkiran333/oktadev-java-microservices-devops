pipeline {
    agent any

    tools {
        maven 'maven'
    }

    stages {

        stage('Build Maven') {
            steps {
                dir('spring-boot+cloud') {
                    sh 'mvn clean install -DskipTests'
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('spring-boot+cloud') {
                    sh 'ls -la'
                    sh 'docker-compose build'
                }
            }
        }

        stage('Run Containers') {
            steps {
                dir('spring-boot+cloud') {
                    sh 'docker-compose up -d'
                }
            }
        }

        stage('Verify Running Containers') {
            steps {
                dir('spring-boot+cloud') {
                    sh 'docker ps'
                }
            }
        }
    }
}